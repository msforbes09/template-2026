APP_NAME=Template
APP_ENV=local
APP_KEY=
# Key for encrypting user PII (the `ciphertext` blob) and deriving the `*_hash`
# blind indexes. Kept separate from APP_KEY so it can be rotated independently;
# falls back to APP_KEY if unset (dev only). REQUIRED in production — the app
# refuses to boot without it (a shared APP_KEY means one leak exposes all PII).
# On first production set, use the CURRENT APP_KEY value to keep existing
# ciphertext readable, then rotate with a backfill. MUST NOT be lost/changed —
# doing so makes all existing PII ciphertext unreadable and invalidates every hash.
PII_ENCRYPTION_KEY=
# Off by default. A debug error page prints the configuration and a stack trace —
# DB password, APP_KEY, partner secrets and all — so one unhandled exception in a
# misconfigured environment is a full disclosure. Turn it on locally when you need it;
# it is forced off in production regardless (AppServiceProvider).
APP_DEBUG=false
APP_URL=http://localhost
APP_SERVICE_NAME=WS

# Swagger UI + its JSON. Defaults OFF in production (the docs enumerate every endpoint,
# parameter and error shape — a map an attacker would otherwise have to draw). Set true
# to expose them anyway. They cannot be put behind auth instead: Swagger UI is a browser
# page and a browser cannot present a Sanctum bearer token.
DOCS_ENABLED=false
APP_VERSION=v0.0.0

# Presented as the `X-Status-Token` header to make `GET /` also return `environment`
# and `version` — the deploy check ("did this domain ship the build I intended?").
# Without the header those two fields are withheld, so the public sees only enough to
# confirm which service answers the domain. Leave unset to never expose them.
#   curl -H "X-Status-Token: $APP_STATUS_TOKEN" https://api.example.com/
APP_STATUS_TOKEN=

# Base URLs for the Swagger "Servers" dropdown (include the /api/v1 prefix), one
# per environment. LOCAL defaults to APP_URL; set STAGING/PRODUCTION to their real
# domains so all three appear in the dropdown.
L5_SWAGGER_CONST_HOST_LOCAL="${APP_URL}/api/v1"
# L5_SWAGGER_CONST_HOST_STAGING=https://staging.api.example.com/api/v1
# L5_SWAGGER_CONST_HOST_PRODUCTION=https://api.example.com/api/v1

# Seeded super administrator (AccessSeeder). Keep the password out of version control.
# No default — a shipped default address is a known account to attack. When unset,
# AccessSeeder seeds permissions + the Super Admin role but SKIPS the super-admin
# account (set these and re-seed to create it).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CORS — comma-separated EXACT allowlist of browser origins (scheme://host:port).
# Unset falls back to local dev origins (localhost/127.0.0.1 on 3000/5173/8080);
# staging/prod MUST set the real frontend host(s), e.g.
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
# CORS_ALLOWED_ORIGINS=
# CORS_MAX_AGE=0

# CloudWatch logging (off by default). To enable in an environment, add `cloudwatch`
# to the stack — LOG_STACK=single,cloudwatch (or daily,cloudwatch) — and set the
# region + a group name. Credentials fall back to the AWS_* vars, or to the ECS/EC2
# IAM role when left blank (do NOT set empty CLOUDWATCH_LOG_KEY if relying on a role).
# CLOUDWATCH_LOG_REGION=ap-southeast-1
# CLOUDWATCH_LOG_KEY=
# CLOUDWATCH_LOG_SECRET=
# CLOUDWATCH_LOG_GROUP_NAME=/template/ws
# CLOUDWATCH_LOG_STREAM_NAME=${APP_ENV}
# CLOUDWATCH_LOG_RETENTION_DAYS=14
# CLOUDWATCH_LOG_BATCH_SIZE=10000
# CloudWatch fallback credentials only — unrelated to R2 file storage.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Audit logging — set DB_AUDIT_CONNECTION=mysql-logs to write audits to a
# separate logs database. DB_LOGS_* override the primary DB_* for that
# connection; unset, it falls back to the primary DB_* values (same database).
# DB_AUDIT_CONNECTION=mysql-logs
# DB_LOGS_HOST=127.0.0.1
# DB_LOGS_PORT=3306
# DB_LOGS_DATABASE=template-logs
# DB_LOGS_USERNAME=root
# DB_LOGS_PASSWORD=
# AUDITING_ENABLED=true

# Connection logging — the DB connection outbound-call logs are written to
# (defaults to mysql-logs; the DB_LOGS_* above apply).
# CONNECTION_LOG_CONNECTION=mysql-logs

# OpenSearch — OPTIONAL, off by default. When enabled, every monthly log write is
# mirrored into OpenSearch (dual-write) for fast list/analytics reads, and lists
# read from it with a MySQL fallback. Access is infra-gated (VPC), so the app talks
# to a plain host string — no IAM/SigV4 in the app. To enable: SCOUT_DRIVER=opensearch,
# OPENSEARCH_READ_ENABLED=true, and run the opensearch service in docker-compose.yml.
OPENSEARCH_HOST=opensearch:9200
SCOUT_DRIVER=null
OPENSEARCH_READ_ENABLED=false
SCOUT_QUEUE_NAME=search
# Index/alias prefix (default template_), shared by every model's searchableAs()
# and the lifecycle templates. Read from SCOUT_PREFIX / OPENSEARCH_MIGRATIONS_INDEX_PREFIX.
# SCOUT_PREFIX=template_
# Log lifecycle (ISM) — a shared policy rolls each log index over and deletes backing
# indices past the retention window (applied at deploy by opensearch:apply-lifecycle).
# OPENSEARCH_LOG_RETENTION_MONTHS=12
# OPENSEARCH_LOG_ROLLOVER_AGE=30d
# OPENSEARCH_LOG_ROLLOVER_SIZE=25gb

# Disposable-email blocklist — cached by `email:cache-disposable-domains` (scheduled
# weekly). Set DISPOSABLE_EMAIL_ENABLED=false to skip the check.
# DISPOSABLE_EMAIL_ENABLED=true
# DISPOSABLE_EMAILS_URL=https://raw.githubusercontent.com/disposable-email-domains/disposable-email-domains/master/disposable_email_blocklist.conf

# Cloudflare Turnstile CAPTCHA (enabled by default; set false locally to skip)
# TURNSTILE_ENABLED=true
# TURNSTILE_SECRET_KEY=

# File uploads (Cloudflare R2) — two buckets. Private objects are served by S3
# presigned URL (R2_PRIVATE_URL_TTL seconds, cached); public objects by plain URL
# from the public bucket's custom domain. R2_ENDPOINT is the account's S3 API
# endpoint. Kept separate from AWS_* so the CloudWatch log channel is unaffected.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_PUBLIC_BUCKET=
# R2_PUBLIC_URL=https://cdn.example.com
# R2_FOLDER=uploads
# R2_PRIVATE_URL_TTL=10800

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Reverb (WebSocket broadcasting). The `reverb-server` pm2 process runs the server
# in the container; the browser reaches it via nginx (location /app -> app:8080),
# so Reverb's port is never published. Set BROADCAST_CONNECTION=log to disable.
# Creds are random per environment — generate a fresh set for each (never share).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server bind + the app's internal publish target (Reverb + app share a container).
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Browser connection config (VITE_REVERB_*) lives in the SEPARATE UI repo, not here —
# this backend has no Echo client. The UI connects via nginx at the public `/app` path
# using REVERB_APP_KEY + public host + web port + scheme
# (local: localhost + COMPOSE_WEBSERVER_PORT + http; staging: your domain + 443 + https).
#
# Hosts allowed to open a WebSocket, comma-separated. This is the ORIGIN header's host,
# not a URL — no scheme, no port. Reverb matches with Str::is, so `*.staging.example.com`
# works. A single `*` disables the origin check entirely; don't.
#
# !! DEPLOY NOTE: every environment MUST set this to its admin-UI host, or the UI's
# !! WebSocket handshake is refused. It used to be `*` (anything), so an environment that
# !! never set it still worked. It now fails closed — which is the point, but it means an
# !! unset value looks exactly like a broken socket.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Set REDIS_SCHEME=tls with a plain REDIS_HOST for a TLS-only managed Redis
# (Valkey/ElastiCache). Drives TLS for BOTH the phpredis connections and the
# Reverb scaling pub/sub connection (without it, Reverb scaling connects
# plaintext and the server resets it → ECONNRESET crash).
REDIS_SCHEME=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="support@example.com"
# Absolute URL of the logo shown in branded emails; leave empty to render the
# app name as text instead.
MAIL_LOGO_URL=

VITE_APP_NAME="${APP_NAME}"

# The inactivity window slides forward on every authenticated request. The absolute
# window never does: it is measured from when the token was issued, so a token that
# keeps being used still dies after 8 hours. Without it a stolen token, being used,
# would never expire at all.
ADMIN_TOKEN_INACTIVITY_MINUTES=60
ADMIN_TOKEN_ABSOLUTE_MINUTES=480
USER_TOKEN_INACTIVITY_MINUTES=60
USER_2FA_ENABLED=true
USER_2FA_TRUST_WINDOW=43200
USER_2FA_MAX_TRUSTED_DEVICES=5
USER_2FA_AUTH_TOKEN_TTL=2100

# Extra trusted proxies (comma-separated IPs/CIDRs) appended to the baked-in
# list in App\Http\TrustedProxies — set to a frontend server's egress IP when it
# calls the API on a browser's behalf, so those calls are attributed to the human
# (it forwards their address in X-Forwarded-For). Per environment — the value
# lives only in that environment's .env, never in the repo. Leave empty locally.
TRUSTED_PROXIES=

# Default per-minute rate limit for every /api/v1/* route (the api group backstop).
API_RATE_LIMIT=60

# Certificate verification for the OpenSearch client. Keep it on everywhere a
# real cert is presented; set false ONLY to reach a cluster through a local
# tunnel, whose self-signed localhost cert can never verify.
# OPENSEARCH_SSL_VERIFY=true

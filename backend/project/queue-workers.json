[
    {
        "name": "worker-scheduler",
        "interpreter": "php",
        "script": "artisan",
        "args": [
            "schedule:run",
            "-vvv"
        ],
        "instances": 1,
        "exec_mode": "fork",
        "cron": "* * * * *",
        "autorestart": false,
        "watch": false,
        "max_memory_restart": "1G"
    },
    {
        "name": "worker-default",
        "interpreter": "php",
        "script": "artisan",
        "args": [
            "queue:work",
            "--tries=3",

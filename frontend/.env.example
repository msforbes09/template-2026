# Copy to .env and fill in real values. Every variable here is validated in
# lib/env.ts; nothing else is read from the environment.

# The product name — the only place a brand is spelled.
NEXT_PUBLIC_APP_NAME=App

# Where this app is served, and where the backend API is.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Cloudflare Turnstile public site key. The default is Cloudflare's
# always-passes test key; set a real one per environment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Signs the Better Auth session cookies for both audiences. Required in
# production: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Production errors are shipped here (Slack incoming webhook).
SLACK_ERROR_WEBHOOK_URL=

# Laravel Reverb (websocket) for notifications and broadcasts. Defaults match
# a local `php artisan reverb:start`. The backend's REVERB_ALLOWED_ORIGINS and
# CORS_ALLOWED_ORIGINS must list NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_REVERB_APP_KEY=local
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_FORCE_TLS=false

# Client-side upload cap, matching the backend's.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=5
